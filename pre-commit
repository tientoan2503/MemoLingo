#!/bin/bash

# Pre-commit hook: runs Spotless and Detekt on staged files only
# Install: copy/symlink to .git/hooks/pre-commit
#
# This hook ensures code quality by:
# 1. Running Spotless for code formatting checks
# 2. Running Detekt for static code analysis
# 3. Only checking staged Kotlin/KTS files

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit checks..."
echo "================================"

# Get the list of staged Kotlin/KTS files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(kt|kts)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${YELLOW}⚠️  No Kotlin files staged. Skipping checks.${NC}"
    exit 0
fi

STAGED_COUNT=$(echo "$STAGED_FILES" | wc -l | tr -d ' ')
echo -e "${YELLOW}📄 Staged Kotlin files (${STAGED_COUNT}):${NC}"
echo "$STAGED_FILES" | sed 's/^/   • /'
echo ""

# Stash unstaged changes to only check what's being committed
STASH_NAME="pre-commit-stash-$(date +%s)"
STASH_RESULT=1  # default: no stash → cleanup will not restore

# Skip stashing during merge commits (MERGE_HEAD exists → git stash refuses to run)
if [ ! -f ".git/MERGE_HEAD" ]; then
    git stash push -q --keep-index --include-untracked -m "$STASH_NAME" 2>/dev/null \
        && STASH_RESULT=0 || STASH_RESULT=1
fi

cleanup() {
    if [ "$STASH_RESULT" -eq 0 ]; then
        # Verify stash exists before popping
        if git stash list | grep -q "$STASH_NAME"; then
            git stash pop -q 2>/dev/null || true
        fi
    fi
}
trap cleanup EXIT

FAILED=0

# ─────────────────────────────────────
# Step 1: Run Spotless check (formatting)
# ─────────────────────────────────────
echo "🎨 [1/2] Running Spotless check..."
SPOTLESS_OUTPUT=$(./gradlew spotlessCheck --daemon -q 2>&1) && SPOTLESS_EXIT=0 || SPOTLESS_EXIT=$?

if [ $SPOTLESS_EXIT -ne 0 ]; then
    echo -e "${RED}❌ Spotless check FAILED.${NC}"
    echo "$SPOTLESS_OUTPUT" | tail -20
    echo ""
    echo -e "${YELLOW}💡 Fix: Run './gradlew spotlessApply' to auto-fix formatting, then re-stage your files.${NC}"
    echo ""
    FAILED=1
else
    echo -e "${GREEN}✅ Spotless check passed.${NC}"
fi

# ─────────────────────────────────────
# Step 2: Run Detekt (static analysis)
# ─────────────────────────────────────
echo "🔎 [2/2] Running Detekt..."
DETEKT_OUTPUT=$(./gradlew detekt --daemon -q 2>&1) && DETEKT_EXIT=0 || DETEKT_EXIT=$?

if [ $DETEKT_EXIT -ne 0 ]; then
    echo -e "${RED}❌ Detekt check FAILED.${NC}"
    echo "$DETEKT_OUTPUT" | tail -20
    echo ""
    echo -e "${YELLOW}💡 Fix: Please resolve the issues above before committing.${NC}"
    echo ""
    FAILED=1
else
    echo -e "${GREEN}✅ Detekt check passed.${NC}"
fi

# ─────────────────────────────────────
# Summary
# ─────────────────────────────────────
echo ""
echo "================================"

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}🚫 Pre-commit checks FAILED. Commit aborted.${NC}"
    echo ""
    echo "To bypass (not recommended): git commit --no-verify"
    exit 1
fi

echo -e "${GREEN}🎉 All pre-commit checks passed!${NC}"
exit
